{
  "openapi": "3.0.3",
  "info": {
    "title": "senda local fuzz contracts",
    "version": "1.0.0",
    "description": "Real application with a temporary database and synthetic signed-in account. Covers read endpoints and malformed/nonexistent project lookups."
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Documented response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Documented response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string",
                          "enum": [
                            "Fuzz test"
                          ]
                        },
                        "email": {
                          "type": "string",
                          "enum": [
                            "fuzz@example.test"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            },
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "responses": {
          "200": {
            "description": "Documented response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "created"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string",
                        "enum": [
                          "Synthetic process"
                        ]
                      },
                      "created": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/browser-tools": {
      "get": {
        "responses": {
          "400": {
            "description": "Documented response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            },
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Documented response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            },
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "200": {
            "description": "Available tools for the synthetic project",
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "description",
                      "inputSchema"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "inputSchema": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "as-is",
                "to-be"
              ]
            }
          }
        ]
      }
    }
  }
}
