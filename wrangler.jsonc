{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "senda",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "main": "./src/cloudflare/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "senda.hanifcarroll.com", "custom_domain": true }],
  "vars": { "APP_URL": "https://senda.hanifcarroll.com", "PRODUCT_NAME": "Senda", "FREE_AGENT_TRIAL_ENABLED": "1" },
  "d1_databases": [{ "binding": "DB", "database_name": "senda", "database_id": "f3c795ce-d98c-4d64-b26b-0cd0b72a21c7", "migrations_dir": "src/cloudflare/migrations" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "senda-private" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["accounts@mail.senda.hanifcarroll.com"] }],
  "workflows": [{ "binding": "AGENT_WORKFLOW", "name": "senda-agent-turns", "class_name": "SendaAgentWorkflow" }],
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "1306187460", "simple": { "limit": 240, "period": 60 } }],
  "limits": { "cpu_ms": 120000 },
  "observability": { "enabled": true, "redact_query_string": true },
  "assets": { "run_worker_first": ["/api/*", "/mcp", "/.well-known/*", "/app", "/app/*", "/sign-in", "/sign-in/*", "/reset-password", "/consent", "/local"] }
}
